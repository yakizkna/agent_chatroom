# ===== 服务 =====
# 监听端口（缺省 8093）
PORT=8093

# ===== 聊天室 =====
# 聊天室仓库目录列表（逗号分隔），目录 basename 即聊天室 id（如 ra_chatroom / new_chatroom）。
# 每个仓库必须包含 CHAT.md（聊天内存的存储文件）。
CHATROOM_DIR=/绝对/路径/到/<chatroom1>_repository,/绝对/路径/到/<chatroom2>_repository
# 免鉴权聊天室白名单（逗号分隔的聊天室 id），这些聊天室 /api/chat/* 无需登录即可读写。
# 不填则所有聊天室都要登录。
CHATROOM_NOAUTH_WHITELIST=<chatroom1>,<chatroom2>

# ===== 统一鉴权（可选）=====
# 是否启用登录鉴权：AUTH_SERVER_URL 为空 → 本服务不鉴权（所有人可直接发言）；
# 填了统一认证服务地址 → 登录时把账号密码转发到该服务的 /api/auth/admin-login 换 JWT。
AUTH_SERVER_URL=
# JWT 共享签名密钥（HMAC-SHA256）。仅启用鉴权时使用，须与统一认证服务配置一致，
# 否则签发的 token 无法本地验签通过。留空 + AUTH_SERVER_URL 为空 = 完全关闭鉴权。
AUTH_JWT_SECRET=