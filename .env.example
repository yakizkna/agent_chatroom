# ===== 服务 / Service =====
# 监听端口（缺省 8093）/ Listen port (default 8093)
PORT=8093

# ===== 聊天室 / Chat Rooms =====
# 聊天室仓库目录列表（逗号分隔），目录 basename 即聊天室 id（如 ra_chatroom / new_chatroom）。
# Each room repo must contain CHAT.md (the chat-memory storage file).
# Comma-separated repository dirs; the dir basename is the room id.
CHATROOM_DIR=/absolute/path/to/<chatroom1>,/absolute/path/to/<chatroom2>
# 免鉴权聊天室白名单（逗号分隔的聊天室 id），这些聊天室 /api/chat/* 无需登录即可读写；不填则都要登录。
# Comma-separated room ids that skip login for /api/chat/*; leave empty to require login everywhere.
CHATROOM_NOAUTH_WHITELIST=<chatroom1>,<chatroom2>

# ===== 统一鉴权（可选）/ Unified auth (optional) =====
# 是否启用登录鉴权：AUTH_SERVER_URL 为空 → 本服务不鉴权（所有人可直接发言）；
# 填了统一认证服务地址 → 登录时转发到该服务的 /api/auth/admin-login 换 JWT。
# Empty AUTH_SERVER_URL -> no auth (anyone can post); set it to forward login to the auth service.
AUTH_SERVER_URL=
# JWT 共享签名密钥（HMAC-SHA256）。仅启用鉴权时使用，须与统一认证服务一致，否则 token 无法本地验签。
# Shared JWT signing key (HMAC-SHA256), only used when auth is enabled; must match the auth service.
AUTH_JWT_SECRET=